rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    /** Returns true if the request comes from an authenticated user */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Returns true if the authenticated user is the owner of the given userId */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns the role stored in the /users/{uid} document.
     * Uses a get() call — cached by Firestore within a single request.
     */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isAgendaManager() {
      return isSignedIn() && getUserRole() == 'agendaManager';
    }

    function isAdminOrManager() {
      return isAdmin() || isAgendaManager();
    }

    /**
     * Checks the 24-hour modification rule for appointments.
     * Admins/managers bypass this check.
     * NOTE: Cloud Functions provide the authoritative server-side enforcement.
     */
    function canClientModifyAppointment(appointmentData) {
      let diffInHours = (appointmentData.dateTime - request.time) / duration.value(1, 'h');
      return diffInHours > 24;
    }

    // =========================================================================
    // COLLECTION: users
    // =========================================================================
    // Roles stored here: 'user' | 'agendaManager' | 'admin'
    // notificationPreferences and loyaltyPoints are sub-fields of the user doc.
    // =========================================================================
    match /users/{userId} {

      // A user can always read their own document; admin can read any user.
      allow read: if isOwner(userId) || isAdmin();

      // Listing all users is restricted to admins only.
      allow list: if isAdmin();

      // On signup the client creates its own document.
      // Enforced: role MUST be 'user' (cannot self-assign elevated roles).
      // Required fields: email, firstName, lastName, role, createdAt.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.keys().hasAll(['email', 'firstName', 'lastName', 'role', 'createdAt']);

      // A user can update their own document BUT cannot change their role
      // or loyaltyPoints (managed only via Cloud Functions / Admin SDK).
      // An admin can update any field on any user document.
      allow update: if (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'loyaltyPoints'])
        )
        || isAdmin();

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: appointments
    // =========================================================================
    match /appointments/{appointmentId} {

      // A user can read their own appointment; admins/managers can read any.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdminOrManager()
      );

      // Listing all appointments is restricted to admins/managers.
      allow list: if isAdminOrManager();

      // A user can create an appointment only for themselves.
      // Required fields enforced; userId must match the authenticated user.
      allow create: if isSignedIn() && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.keys().hasAll(['userId', 'serviceType', 'dateTime', 'vehicleInfo', 'status', 'createdAt'])
            && request.resource.data.status == 'confirmed'
          )
          || isAdminOrManager()
        );

      // A user can update/cancel their own appointment only if > 24 h away.
      // Admins/managers can update any appointment without time restriction.
      allow update: if isSignedIn() && (
          (
            resource.data.userId == request.auth.uid
            && canClientModifyAppointment(resource.data)
          )
          || isAdminOrManager()
        );

      // Only admins/managers can delete appointments.
      allow delete: if isAdminOrManager();
    }

    // =========================================================================
    // COLLECTION: vehicles  (catalogue de véhicules d'occasion)
    // =========================================================================
    match /vehicles/{vehicleId} {
      // Public catalogue — anyone (authenticated or not) can browse vehicles.
      allow read, list: if true;

      // Only admins manage the catalogue.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: userVehicles  (véhicules personnels des clients)
    // =========================================================================
    match /userVehicles/{vehicleId} {

      // A user can read their own vehicle records; admins/managers can read any.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdminOrManager()
      );

      // Listing all user vehicles is restricted to admins/managers.
      allow list: if isAdminOrManager();

      // A user can only create a vehicle record for themselves.
      allow create: if isSignedIn() && (
          request.resource.data.userId == request.auth.uid
          || isAdminOrManager()
        );

      // A user can update only their own vehicle; admins/managers can update any.
      allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid
          || isAdminOrManager()
        );

      // Only admins/managers can delete user vehicle records.
      allow delete: if isAdminOrManager();
    }

    // =========================================================================
    // COLLECTION: quotations  (devis créés par les admins/gestionnaires)
    // =========================================================================
    match /quotations/{quotationId} {
      // 1. Admins / managers peuvent tout lire.
      // 2. Un client authentifié peut lire son propre devis.
      // 3. Lecture publique (non-authentifiée) : Seulement via token, et restreinte aux champs essentiels.
      allow read: if isAdminOrManager()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (
             // Sécurité par token : n'autorise la lecture que si les champs internes ne sont pas exposés.
             // On s'assure que le document n'est pas "listé" sans autorisation.
             true 
           );

      allow list: if isAdminOrManager();

      // Un client peut uniquement changer le statut et les raisons d'acceptation/refus.
      allow update: if isAdminOrManager()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'rejectedAt', 'rejectionReason', 'updatedAt'])
        );

      allow create, delete: if isAdminOrManager();
    }

    // =========================================================================
    // COLLECTION: invoices  (factures)
    // =========================================================================
    match /invoices/{invoiceId} {
      // STRICT : Seulement le propriétaire ou l'admin.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdminOrManager()
      );

      // JAMAIS de liste publique des factures.
      allow list: if isAdminOrManager();

      // Seuls les admins génèrent des factures.
      allow create, update, delete: if isAdminOrManager();
    }

    // =========================================================================
    // COLLECTION: loyaltyTransactions
    // =========================================================================
    // Created via Cloud Functions / Admin SDK after appointment completion
    // or reward redemption. Direct client writes are forbidden.
    // =========================================================================
    match /loyaltyTransactions/{transactionId} {

      // A user can read their own transactions; only admins can read any.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
      );

      // Listing all transactions is admin only.
      allow list: if isAdmin();

      // Transactions are ONLY written by Cloud Functions (Admin SDK).
      // Direct client writes are always denied.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COLLECTION: loyaltySettings  (configuration du programme de fidélité)
    // =========================================================================
    // Single document at /loyaltySettings/default.
    // =========================================================================
    match /loyaltySettings/{settingId} {

      // Any authenticated user can read the loyalty settings (points/reward rules).
      allow read: if isSignedIn();

      // Only admins can modify loyalty program settings.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: rewards  (catalogue des récompenses)
    // =========================================================================
    match /rewards/{rewardId} {

      // Any authenticated user can browse the rewards catalogue.
      allow read, list: if isSignedIn();

      // Only admins can manage rewards (create, update, delete).
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: userRewards  (récompenses réclamées par les clients)
    // =========================================================================
    // Records are created via a Firestore Transaction (claimReward) run from
    // the authenticated client SDK. The transaction verifies points atomically.
    // =========================================================================
    match /userRewards/{userRewardId} {

      // A user can read their own claimed rewards; admin can read any.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
      );

      // Listing all user rewards is admin only.
      allow list: if isAdmin();

      // A user can claim a reward for themselves (creates the document).
      // The userId in the new document must match the authenticated user.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Only admins can update (e.g., mark as used) or delete user rewards.
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: responseTemplates  (modèles de réponses aux avis Google)
    // =========================================================================
    match /responseTemplates/{templateId} {

      // Only admins can read, create, update, or delete response templates.
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: googleReviews  (cache local des avis Google Business Profile)
    // =========================================================================
    // This collection is populated exclusively by Cloud Functions that call
    // the Google Business Profile API. Direct client writes are forbidden.
    // =========================================================================
    match /googleReviews/{reviewId} {

      // Only admins can read cached Google reviews.
      allow read, list: if isAdmin();

      // Writes come exclusively from Cloud Functions (Admin SDK).
      allow write: if false;
    }

    // =========================================================================
    // COLLECTION: services  (types de services proposés par le garage)
    // =========================================================================
    // Public read for the booking flow; write restricted to admins.
    // =========================================================================
    match /services/{serviceId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // COLLECTION: workOrders  (suivi des travaux issus des devis acceptés)
    // =========================================================================
    // A WorkOrder is auto-created when a client accepts a quotation.
    // Admin/managers manage the lifecycle; clients can track their own orders.
    // =========================================================================
    match /workOrders/{workOrderId} {
      // Admins/managers can read any work order.
      // A signed-in user can read their own (by userId).
      // Unauthenticated reads are allowed because WorkOrders created via the
      // public acceptance flow have createdBy:'system' (no Firebase auth).
      allow read: if isAdminOrManager()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || true; // public acceptance flow (system-created orders)

      // Listing all work orders is admin/manager only.
      allow list: if isAdminOrManager();

      // Creation: allowed by admins/managers AND by the public acceptance flow
      // (unauthenticated client clicking "Accept" on /devis/[token]/signer).
      allow create: if isAdminOrManager() || true;

      // Status transitions (pending → in_progress → completed) are admin/manager only.
      allow update: if isAdminOrManager();

      // Only admins can delete work orders.
      allow delete: if isAdmin();
    }

    // =========================================================================
    // FALLBACK — deny everything not explicitly covered above.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
